# Окружение. dev - для разработки, prod, production - для продакшена
APP_ENV=dev

# API
HTTP_HOST=127.0.0.1
HTTP_PORT=8000

# Redis
REDIS_HOST=v-redis
REDIS_PORT=6379
REDIS_URL=${REDIS_HOST}:${REDIS_PORT}

# PostgreSQL
DB_NAME=antifraud
DB_HOST=v-postgres
DB_PORT=5432

POSTGRES_DB_USER=postgres
POSTGRES_DB_PASSWORD=secret_password
POSTGRES_DB_URL=postgres://${POSTGRES_DB_USER}:${POSTGRES_DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable

MIGRATOR_DB_USER=migration_user
MIGRATOR_DB_PASSWORD=secret_password
MIGRATOR_DB_URL=postgres://${MIGRATOR_DB_USER}:${MIGRATOR_DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable

APP_DB_USER=app_user
APP_DB_PASSWORD=secret_password
APP_DB_URL=postgres://${APP_DB_USER}:${APP_DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable

READONLY_DB_USER=readonly_user
READONLY_DB_PASSWORD=secret_password
READONLY_DB_URL=postgres://${READONLY_DB_USER}:${READONLY_DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable