# Окружение. dev - для разработки, prod, production - для продакшена
APP_ENV=dev

# API
HTTP_HOST=127.0.0.1
HTTP_PORT=8000

# Redis
REDIS_HOST=v-redis
REDIS_PORT=6379
REDIS_URL=${REDIS_HOST}:${REDIS_PORT}

# PostgreSQL
DB_NAME=antifraud
DB_HOST=v-postgres
DB_PORT=5432

POSTGRES_DB_USER=postgres
POSTGRES_DB_PASSWORD=secret_password

DB_URL=postgres://${POSTGRES_DB_USER}:${POSTGRES_DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable